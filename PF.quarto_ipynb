    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# Tiempo de respuesta vs Toxicity\n",
        "sns.scatterplot(data=df, x='time_response', y='toxicity_score')\n",
        "plt.title('Dispersión entre tiempo de respuesta y Toxicity')\n",
        "plt.xlabel('Tiempo de respuesta')\n",
