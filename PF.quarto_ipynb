    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "menciones = df['mentions'].dropna()\n",
        "\n",
        "df_mentions = pd.DataFrame({\n",
        "    'DanielNoboaOk': menciones.str.count('@DanielNoboaOk'),\n",
        "    'LuisaGonzalezEc': menciones.str.count('@LuisaGonzalezEc')\n",
        "}).sum().reset_index()\n",
        "\n",
        "df_mentions.columns = ['Usuario', 'Conteo']\n",
        "\n",
        "sns.barplot(data=df_mentions, x='Usuario', y='Conteo')\n",
        "plt.title('Conteo de menciones por usuario')\n",
