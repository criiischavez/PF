    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "df_mencion_toxicidad = pd.DataFrame({\n",
        "    'DanielNoboaOk': df['mentions'].str.contains('@DanielNoboaOk', na=False),\n",
        "    'LuisaGonzalezEc': df['mentions'].str.contains('@LuisaGonzalezEc', na=False),\n",
        "    'toxicity_score': df['toxicity_score']\n",
        "})\n",
        "\n",
        "df_melt = df_mencion_toxicidad.melt(\n",
        "    id_vars='toxicity_score',\n",
        "    var_name='Usuario',\n",
        "    value_name='Mencionado'\n",
        ")\n",
        "\n",
        "sns.boxplot(data=df_melt[df_melt['Mencionado']], x='Usuario', y='toxicity_score')\n",
        "plt.title('Relación entre mención y nivel de toxicidad')\n",
        "plt.xlabel('Usuario mencionado')\n",
        "plt.ylabel('Toxicity Score')\n",
        "plt.show()"
      ],
      "id": "43772e86",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "Aquí se puede ver que el tiempo por encima de los 10000 segundos es un outliner"
